# GrimHallow — root env template. Copy to .env and fill in.
# Never commit .env. Never put a player's key anywhere in here.

# ---------------------------------------------------------------------------
# Network selection: devnet | testnet | mainnet
# ---------------------------------------------------------------------------
STACKS_NETWORK=devnet

# Deployer principal for the three contracts. Recorded once at Phase 1 deploy
# time; consumed by both api and web via packages/shared/src/contracts.ts.
STACKS_DEPLOYER_ADDRESS=
# Optional override; defaults per network in packages/shared/src/contracts.ts
STACKS_API_URL=
HIRO_API_KEY=

# ---------------------------------------------------------------------------
# Signing keys — KEPT DELIBERATELY SEPARATE (02-architecture.md#7)
#
# ORACLE key: signs commit-seed / reveal-and-resolve ONLY. It can move
#   sponsor-pool funds, so it is the higher-risk key.
# OWNER key: signs admin actions (fund-pool, create-dungeon, create-recipe).
#
# Use two different accounts even though you operate both for MVP. If the
# oracle process is compromised, the owner key must not be in the same blast
# radius.
#
# The backend NEVER holds a player key. Player actions are unsigned tx payloads
# returned to the browser for the wallet to sign.
#
# Fill these with `node scripts/derive-deployer-key.mjs --write`, which derives
# the deployer account from the seed phrase in contracts/settings/<Net>.toml
# without ever printing the key. CONTRACT-OWNER is bound to whoever deployed, so
# the owner key must be that exact account or every owner-only call fails.
# ---------------------------------------------------------------------------
ORACLE_PRIVATE_KEY=
# Oracle principal. Preferred over deriving it from the key: a machine that only
# runs deployments should never need the oracle's private key at all.
ORACLE_ADDRESS=
OWNER_PRIVATE_KEY=
# Owner principal — the paid-entry revenue recipient. Also the switch that turns
# the /admin routes on; leaving it empty leaves them off.
OWNER_ADDRESS=

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
# Browser origins allowed to call the API, comma-separated. Exact match, so no
# trailing slash and no wildcards. A hosted frontend needs more than one entry:
# the production domain plus any preview domain you actually use.
#   WEB_ORIGIN=https://grimhallow.vercel.app,https://grimhallow-git-dev.vercel.app
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
DATABASE_URL=postgres://grimhallow:grimhallow@localhost:5432/grimhallow
# TLS to Postgres. Left unset it does the right thing on its own: off for a
# localhost connection string, on for anything else — which is what a managed
# host such as Supabase requires. Set to `false` only to force it off.
DATABASE_SSL=
# Optional CA certificate (PEM). With it, the server's certificate is verified
# properly; without it, the connection is encrypted but the certificate is not
# checked, which stops passive snooping but not an active man-in-the-middle.
DATABASE_SSL_CA=
# Secret for the short-lived JWT issued after wallet challenge/verify.
JWT_SECRET=

# Shared secret for POST|GET /jobs/loot-mint, the endpoint a platform scheduler
# calls to advance free-run loot minting one step (docs/08-deployment.md §4.5).
# Leaving it blank switches that endpoint off — it is never "no secret required",
# because a pass spends the oracle account's STX on fees. Only needed where a
# timer cannot run (Vercel); a host that owns its own process drives the same
# loop on setInterval instead. `openssl rand -hex 32`.
#
# The name is fixed: Vercel sends `Authorization: Bearer $CRON_SECRET` on its
# cron invocations when a variable by that name exists, and sends nothing
# otherwise.
#
# In production the same value is set twice: here (the API's env store) and as a
# GitHub repository secret, because .github/workflows/loot-mint.yml is the driver
# and Vercel's daily cron is only the backstop. See docs/08-deployment.md §4.5.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Web (Vite — only VITE_-prefixed vars reach the browser)
#
# VITE_API_URL is the only one the app actually reads; network and contract
# addresses come from the API's /config route, so they cannot drift. The two
# below it are declared in src/vite-env.d.ts but currently unused — leaving them
# blank changes nothing.
#
# Baked into the bundle at build time, not read at runtime: changing it on the
# host requires a rebuild. A hosted build refuses to start if this is missing,
# localhost, or plain http (see apps/web/vite.config.ts).
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8080
VITE_STACKS_NETWORK=devnet
VITE_STACKS_DEPLOYER_ADDRESS=
