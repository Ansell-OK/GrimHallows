# Dependencies
node_modules/
.pnp/
.pnp.js

# Builds
dist/
build/
.vite/
*.tsbuildinfo
# esbuild output for the Vercel function — the Build Output API bundle
# (.vercel/output/...) generated by `npm run build` in apps/api. Committing it
# would put a 2 MB artifact under review and let a stale bundle deploy over
# fresh source. Also covers any local `vercel link` metadata.
.vercel/

# Env — never commit real keys
.env
.env.*
!.env.example

# Deployment certificates are environment secrets, not repository assets.
security/*.crt
security/*.pem

# Scratch file for a plaintext seed phrase, read by scripts/derive-oracle-key.mjs
# and meant to be deleted right after. Ignored by exact name AND by suffix so a
# renamed copy (oracle-mnemonic.bak, my.mnemonic) can't slip through.
oracle-mnemonic.txt
*.mnemonic

# Clarinet — Mainnet/Testnet settings carry the seed phrase. Devnet.toml is
# left tracked on purpose: it uses Clarinet's public default mnemonic.
contracts/.cache/
contracts/history.txt
contracts/settings/Mainnet.toml
contracts/settings/Testnet.toml

# Backups — a *.toml.bak of a mainnet settings file still holds the mnemonic,
# so the exact-path Clarinet rules above do not cover it. Ignore all backups.
*.bak

# Not published: local design/spec docs and Claude Code workspace config.
docs/
.claude/

# Logs / OS
*.log
npm-debug.log*
.DS_Store
Thumbs.db
