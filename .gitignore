# Dependencies
node_modules/
.pnp/
.pnp.js

# Builds
dist/
build/
.vite/
*.tsbuildinfo
# esbuild output for the Vercel function — generated by `npm run build`
# in apps/api. Committing it would put a 2 MB artifact under review and let a
# stale bundle deploy over fresh source.
apps/api/api/
.vercel/

# Env — never commit real keys
.env
.env.*
!.env.example

# Clarinet — Mainnet/Testnet settings carry the seed phrase. Devnet.toml is
# left tracked on purpose: it uses Clarinet's public default mnemonic.
contracts/.cache/
contracts/history.txt
contracts/settings/Mainnet.toml
contracts/settings/Testnet.toml

# Backups — a *.toml.bak of a mainnet settings file still holds the mnemonic,
# so the exact-path Clarinet rules above do not cover it. Ignore all backups.
*.bak

# Not published: local design/spec docs and Claude Code workspace config.
docs/
.claude/

# Logs / OS
*.log
npm-debug.log*
.DS_Store
Thumbs.db
